# Copy to .env next to docker-compose.yml and edit. Compose reads it
# automatically. Everything else is configured in the browser.

# Required. The database password. Anything you like, as long as it is not this.
POSTGRES_PASSWORD=change-me

# The port PitWatch is reachable on, on this host. Change it freely; nothing
# inside the container moves. Not called PITWATCH_PORT on purpose, because that
# is the application's own bind port and lives inside the container.
PITWATCH_HOST_PORT=8080

# Where Postgres is published on this host. Only used by the host networking
# setup, where the application connects to it, and by the optional publish block
# in the bridge setup. Change it if 5432 is already taken on this machine.
POSTGRES_HOST_PORT=5432

# Used for every timestamp shown on the dashboard. Storage is always UTC.
PITWATCH_TIMEZONE=America/New_York

# Set this to true when a proxy in front is terminating TLS, which it should be
# if this is reachable from anywhere but your own network. It marks the session
# cookie Secure, so a browser will never send it over plain HTTP.
PITWATCH_SECURE_COOKIES=false

# Which addresses may say, through X-Forwarded-For, who the client really is.
# Set it to the address your reverse proxy connects from. The default is right
# when the proxy runs on the same host. Trusting everything, with "*", lets
# anyone who can reach this port claim to be any address they like, which
# defeats the per address sign in throttling.
PITWATCH_TRUSTED_PROXIES=127.0.0.1,::1

# How long "stay signed in" lasts.
PITWATCH_SESSION_DAYS=30

# INFO is right for normal running. DEBUG logs every reading the Shelly pushes,
# which is a line a second, so turn it on to chase a problem and back off after.
PITWATCH_LOG_LEVEL=INFO

# Optional. Fill these in and the first boot comes up already pointed at the
# hardware. They seed the settings once, while they are empty; after setup runs,
# these are ignored and the settings page is in charge.
SHELLY_HOST=
WAVESHARE_HOST=
