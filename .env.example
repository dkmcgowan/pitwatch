# Copy to .env next to docker-compose.yml. Compose reads it automatically.
#
# These are the settings that have no sensible default. Everything else lives
# in docker-compose.yml, with a comment next to it saying what it does.

POSTGRES_PASSWORD=change-me

# The broker the panel module publishes to. Type the same user name and
# password into the module, under Setup then MQTT. The port has to match too;
# 1883 is the usual one, and there is no reason to move it unless something
# else on this machine is already there.
MQTT_USERNAME=pitwatch
MQTT_PASSWORD=change-me-too
MQTT_PORT=1883
