# Copy to .env next to docker-compose.yml and edit. Compose reads it
# automatically. Everything else is configured in the browser.

# Required. The database password. Anything you like, as long as it is not this.
POSTGRES_PASSWORD=change-me

# The port PitWatch listens on, on the host.
PITWATCH_PORT=8080

# Used for every timestamp shown on the dashboard. Storage is always UTC.
PITWATCH_TIMEZONE=America/New_York

# INFO is right for normal running. DEBUG logs every reading the Shelly pushes,
# which is a line a second, so turn it on to chase a problem and back off after.
PITWATCH_LOG_LEVEL=INFO

# Optional. Fill these in and the first boot comes up already pointed at the
# hardware. They seed the settings once, while they are empty; after setup runs,
# these are ignored and the settings page is in charge.
SHELLY_HOST=
WAVESHARE_HOST=
